{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NagarSetuWaterPipeAnnotationSchema_v12",
  "description": "Standardized schema for municipal water pipeline visual inspection and classification.",
  "type": "object",
  "required": [
    "image_id",
    "parent_id",
    "sha256",
    "dhash",
    "primary_class",
    "scenario_tags",
    "pipe_material",
    "review_status",
    "first_reviewer",
    "review_date",
    "dataset_split"
  ],
  "properties": {
    "image_id": {
      "type": "string",
      "pattern": "^WTR-P12-[0-9]{3}$",
      "description": "Unique identifier for the physical photograph."
    },
    "parent_id": {
      "type": "string",
      "pattern": "^WTR-PARENT-[0-9]{3}$",
      "description": "Parent photograph session identity for group-based split containment."
    },
    "cluster_id": {
      "type": "string",
      "pattern": "^CLUSTER-[0-9]{3}$",
      "description": "Perceptual dHash cluster ID (Hamming distance <= 5)."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 cryptographic hash of the original raw photograph."
    },
    "dhash": {
      "type": "integer",
      "description": "64-bit difference hash for perceptual similarity."
    },
    "primary_class": {
      "type": "string",
      "enum": [
        "normal_pipe",
        "pipe_leak",
        "rusted_pipe",
        "uncertain_needs_review"
      ],
      "description": "Primary high-level triage category."
    },
    "scenario_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "clean_intact",
          "joint_flange_leak",
          "high_pressure_spray",
          "hairline_crack",
          "microscopic_weeping",
          "dry_surface_rust",
          "corroded_joint",
          "cold_pipe_condensation",
          "humidity_droplets",
          "wet_surface_non_leak",
          "specular_glare",
          "deep_shadow",
          "underground_pit",
          "paved_road_background"
        ]
      },
      "minItems": 1,
      "description": "Granular environmental and physical condition descriptors."
    },
    "pipe_material": {
      "type": "string",
      "enum": [
        "PVC_CPVC",
        "Galvanized_Iron",
        "Cast_Iron_Ductile",
        "Copper",
        "Reinforced_Concrete",
        "Unknown_Metal"
      ]
    },
    "pipe_diameter_range": {
      "type": "string",
      "enum": [
        "< 1 inch",
        "1 - 3 inches",
        "4 - 8 inches",
        "> 8 inches",
        "unknown"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "VERIFIED_SINGLE_REVIEW",
        "VERIFIED_DUAL_REVIEW",
        "FLAGGED_FOR_EXPERT_REVIEW",
        "REJECTED_BLURRY_OR_INVALID"
      ]
    },
    "first_reviewer": {
      "type": "string",
      "description": "Identifier of the primary annotator."
    },
    "second_reviewer": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the verifying senior engineer (mandatory for edge cases)."
    },
    "review_date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date of review."
    },
    "dataset_split": {
      "type": "string",
      "enum": [
        "train",
        "val",
        "frozen_test"
      ]
    },
    "source_permission": {
      "type": "string",
      "enum": [
        "INTERNAL_RESEARCH_VERIFIED",
        "FIELD_MUNICIPAL_SURVEY",
        "PUBLIC_DOMAIN"
      ]
    }
  }
}